# Copy this file to .env and fill in your own values.
# Never commit .env — it is already listed in .gitignore.

# Port the app listens on.
PORT=3000

# Base URL used to build public event links (no trailing slash).
# Leave as-is for local development.
APP_URL=http://localhost:3000

# ---- MySQL (XAMPP) -------------------------------------------------------
# XAMPP's default MySQL user is "root" with an EMPTY password. If you set a
# password in phpMyAdmin, put it in DB_PASSWORD. Create the database first
# (e.g. "mawid", collation utf8mb4_unicode_ci) in phpMyAdmin.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mawid

# Optional: instead of the DB_* lines above you can give one connection URL.
# If DATABASE_URL is set, it is used and the DB_* values are ignored.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
# DATABASE_URL=mysql://root:@localhost:3306/mawid

# Optional: max MySQL connections used by the app (default 10).
# DB_POOL_SIZE=10

# ---- Sessions ------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# "development" locally. "production" turns on secure (HTTPS-only) cookies.
NODE_ENV=development
